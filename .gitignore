# Zig
.zig-cache/
zig-out/
*.o
zig-pkg/
.zigversion

# pixi environments
.pixi/*
!.pixi/config.toml

# compiler environments for local tests (pixi), not repository content
/.toolchains/

# written by site/gen for Zine
/site/content/
/site/assets/site-index.json
/site/assets/editions.json
/site/assets/logo.svg
# the files that pages link to, copied for Zine (site/gen/main.zig)
/site/assets/img/
/site/assets/v[0-9]*/
# the site as built (zig build -p ../.site, in site/)
/.site/

# python
__pycache__/
*.pyc
*.pyo
*.pyd

azure.json
