C     A FIXED-FORM FILE OF SUFFIX .F77, PREPROCESSED, WHICH LLVM FLANG READS AS
C     FORTRAN ONLY WITH -x f95 (ZFLS #401)
      MODULE SUFFIX_F77_PP
      IMPLICIT NONE
#ifdef NOT_DEFINED
      INTEGER NOT_DECLARED
#else
      INTEGER COUNT
#endif
      REAL VALUES(10)
      CONTAINS
      SUBROUTINE FILL(N)
      INTEGER N, I
      DO 10 I = 1, N
        VALUES(I) = I
   10 CONTINUE
      COUNT = N
      END SUBROUTINE
      END MODULE
