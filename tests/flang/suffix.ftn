C     A FIXED-FORM FILE OF SUFFIX .ftn, WHICH LLVM FLANG'S DRIVER READS AS
C     FORTRAN ONLY WITH -x f95 (ZFLS #401)
      MODULE SUFFIX_FTN
      IMPLICIT NONE
      INTEGER COUNT
      REAL VALUES(10)
      CONTAINS
      SUBROUTINE FILL(N)
      INTEGER N, I
      DO 10 I = 1, N
        VALUES(I) = I
   10 CONTINUE
      COUNT = N
      END SUBROUTINE
      END MODULE
