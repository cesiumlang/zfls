#!/usr/bin/env bash
PATH_rm '/c/scratch/git/zig-build/*'

# direnv: Node.js for building the extension, the version in .node-version, through fnm
if has fnm; then
  eval "$(fnm env --shell bash)"
  fnm use --install-if-missing --silent-if-unchanged
fi

