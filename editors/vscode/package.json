{
  "name": "zfls",
  "displayName": "zfls: Fortran Language Server",
  "description": "Fortran language support powered by zfls, a fast native re-implementation of fortls; a replacement for the Modern Fortran extension",
  "version": "0.1.3",
  "publisher": "cesiumlang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesiumlang/zfls"
  },
  "bugs": {
    "url": "https://github.com/cesiumlang/zfls/issues"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fortran",
    "fortls",
    "language server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "FortranFreeForm",
        "aliases": [
          "Fortran",
          "Fortran90"
        ],
        "extensions": [
          ".f90",
          ".F90",
          ".f95",
          ".F95",
          ".f03",
          ".F03",
          ".f08",
          ".F08",
          ".f18",
          ".F18",
          ".fpp",
          ".FPP",
          ".pf",
          ".PF",
          ".fypp",
          ".FYPP"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fortran.svg",
          "dark": "./icons/fortran.svg"
        }
      },
      {
        "id": "FortranFixedForm",
        "aliases": [
          "Fortran77"
        ],
        "extensions": [
          ".f",
          ".F",
          ".f77",
          ".F77",
          ".for",
          ".FOR"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fortran.svg",
          "dark": "./icons/fortran.svg"
        }
      },
      {
        "id": "jsonc",
        "filenames": [
          ".fortlsrc",
          ".fortls.json",
          ".fortls"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "FortranFreeForm"
      },
      {
        "language": "FortranFixedForm"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".fortlsrc",
          ".fortls.json",
          ".fortls"
        ],
        "url": "./schemas/fortls.schema.json"
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "fpm.toml",
        "url": "https://github.com/fortran-lang/fpm-metadata/releases/download/v0.2.2/fpm-metadata-0.2.2.json"
      }
    ],
    "grammars": [
      {
        "language": "FortranFreeForm",
        "scopeName": "source.fortran.free",
        "path": "./syntaxes/fortran_free-form.tmLanguage.json"
      },
      {
        "scopeName": "source.openmp",
        "path": "./syntaxes/openmp_lang.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "scopeName": "source.openacc",
        "path": "./syntaxes/openacc_lang.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "language": "FortranFixedForm",
        "scopeName": "source.fortran.fixed",
        "path": "./syntaxes/fortran_fixed-form.tmLanguage.json"
      },
      {
        "scopeName": "comment.line.fixed.injection",
        "path": "./syntaxes/fortran_fixed-form-comments.injection.json",
        "injectTo": [
          "source.fortran.fixed"
        ]
      }
    ],
    "snippets": [
      {
        "language": "FortranFreeForm",
        "path": "./snippets/fortran-free-form.json"
      },
      {
        "language": "FortranFixedForm",
        "path": "./snippets/fortran-fixed-form.json"
      }
    ],
    "configuration": {
      "title": "zfls",
      "properties": {
        "zfls.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to a `zfls` executable. Empty: the one bundled with this extension, or else `zfls` on the `PATH` (for example from `conda install -c conda-forge zfls`)."
        },
        "zfls.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--incremental_sync",
            "--use_signature_help",
            "--enable_code_actions",
            "--hover_signature"
          ],
          "markdownDescription": "Command-line arguments for `zfls`; it accepts the same options as fortls (run `zfls --help`). The default turns on incremental sync, signature help, code actions and signatures in hover; remove an option to turn that feature off. Settings in a `.fortlsrc`, `.fortls.json` or `.fortls` file in the workspace also apply."
        },
        "zfls.disableModernFortranCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Do not recommend disabling the Modern Fortran extension, which zfls replaces, when both are enabled."
        },
        "zfls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Log the messages between VS Code and zfls in the `zfls` output channel."
        },
        "zfls.formatting.formatter": {
          "type": "string",
          "enum": [
            "Disabled",
            "findent",
            "fprettify"
          ],
          "enumDescriptions": [
            "Do not format Fortran files",
            "Indent with findent (free and fixed form)",
            "Format with fprettify (free form only)"
          ],
          "default": "Disabled",
          "scope": "language-overridable",
          "markdownDescription": "The external tool that formats Fortran files and selections (**Format Document**, **Format Selection**, format on save). It must be installed separately: `pip install findent` or `pip install fprettify`. Can be set per language, for example `\"[FortranFixedForm]\": { \"zfls.formatting.formatter\": \"findent\" }`."
        },
        "zfls.formatting.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The formatter executable, or the directory that holds it, when it is not on the `PATH`. `${workspaceFolder}`, `${env:NAME}`, `${userHome}` and a leading `~` are expanded; a relative path is relative to the workspace folder."
        },
        "zfls.formatting.findentArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "language-overridable",
          "markdownDescription": "Extra arguments for `findent`, one per item, for example `[\"-i4\"]`. The extension passes `-ifree` or `-ifixed` from the file's language unless these set the input format, and `-Ia` (keep the selection's indentation) when formatting a selection. Variables are expanded as in `#zfls.formatting.path#`."
        },
        "zfls.formatting.fprettifyArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "language-overridable",
          "markdownDescription": "Extra arguments for `fprettify`, one per item, for example `[\"--indent\", \"4\", \"--enable-decl\"]`. fprettify also reads `.fprettify.rc` files from the file's directory and its parents. Variables are expanded as in `#zfls.formatting.path#`."
        }
      }
    },
    "commands": [
      {
        "command": "zfls.restart",
        "title": "Restart Language Server",
        "category": "zfls"
      },
      {
        "command": "zfls.showOutput",
        "title": "Show Output",
        "category": "zfls"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify --sourcemap",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "package": "vsce package --no-dependencies",
    "build-test": "esbuild test/runTest.ts --bundle --outfile=out/runTest.js --platform=node --target=node20 && esbuild test/suite.ts --bundle --outfile=out/suite.js --external:vscode --format=cjs --platform=node --target=node20",
    "test": "npm run build && npm run build-test && node out/runTest.js",
    "unit": "esbuild test/unit/*.test.ts --bundle --outdir=out/unit --platform=node --target=node20 --format=cjs && node --test out/unit/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
