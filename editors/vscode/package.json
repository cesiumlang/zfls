{
  "name": "zfls",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.3",
  "publisher": "cesiumlang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesiumlang/zfls"
  },
  "bugs": {
    "url": "https://github.com/cesiumlang/zfls/issues"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fortran",
    "fortls",
    "language server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugDynamicConfigurations:fortran",
    "onDebugInitialConfigurations",
    "onDebugResolve:fortran",
    "onTaskType:fpm",
    "workspaceContains:fpm.toml"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "zfls reads the project's Fortran files from disk."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "FortranFreeForm",
        "aliases": [
          "Fortran",
          "Fortran90"
        ],
        "extensions": [
          ".f90",
          ".F90",
          ".f95",
          ".F95",
          ".f03",
          ".F03",
          ".f08",
          ".F08",
          ".f18",
          ".F18",
          ".fpp",
          ".FPP",
          ".cuf",
          ".CUF",
          ".pf",
          ".PF",
          ".fypp",
          ".FYPP"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fortran.svg",
          "dark": "./icons/fortran.svg"
        }
      },
      {
        "id": "FortranFixedForm",
        "aliases": [
          "Fortran77"
        ],
        "extensions": [
          ".f",
          ".F",
          ".f77",
          ".F77",
          ".for",
          ".FOR"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fortran.svg",
          "dark": "./icons/fortran.svg"
        }
      },
      {
        "id": "FortranNamelist",
        "aliases": [
          "Fortran Namelist",
          "namelist"
        ],
        "extensions": [
          ".nml",
          ".NML",
          ".namelist"
        ],
        "configuration": "./language-configuration-namelist.json",
        "icon": {
          "light": "./icons/fortran.svg",
          "dark": "./icons/fortran.svg"
        }
      },
      {
        "id": "jsonc",
        "filenames": [
          ".fortlsrc",
          ".fortls.json",
          ".fortls"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "FortranFreeForm"
      },
      {
        "language": "FortranFixedForm"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".fortlsrc",
          ".fortls.json",
          ".fortls"
        ],
        "url": "./schemas/fortls.schema.json"
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "fpm.toml",
        "url": "https://github.com/fortran-lang/fpm-metadata/releases/download/v0.2.2/fpm-metadata-0.2.2.json"
      }
    ],
    "grammars": [
      {
        "language": "FortranFreeForm",
        "scopeName": "source.fortran.free",
        "path": "./syntaxes/fortran_free-form.tmLanguage.json"
      },
      {
        "scopeName": "source.openmp",
        "path": "./syntaxes/openmp_lang.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "scopeName": "source.fypp.injection",
        "path": "./syntaxes/fypp.injection.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "scopeName": "source.openacc",
        "path": "./syntaxes/openacc_lang.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "scopeName": "source.fortran.doc-code.injection",
        "path": "./syntaxes/fortran_doc-code.injection.json",
        "injectTo": [
          "source.fortran.free"
        ]
      },
      {
        "language": "FortranFixedForm",
        "scopeName": "source.fortran.fixed",
        "path": "./syntaxes/fortran_fixed-form.tmLanguage.json"
      },
      {
        "scopeName": "comment.line.fixed.injection",
        "path": "./syntaxes/fortran_fixed-form-comments.injection.json",
        "injectTo": [
          "source.fortran.fixed"
        ]
      },
      {
        "scopeName": "source.fortran.comment-markers.injection",
        "path": "./syntaxes/fortran_comment-markers.injection.json",
        "injectTo": [
          "source.fortran.free",
          "source.fortran.fixed"
        ]
      },
      {
        "language": "FortranNamelist",
        "scopeName": "source.fortran.namelist",
        "path": "./syntaxes/fortran_namelist.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "FortranFreeForm",
        "path": "./snippets/fortran-free-form.json"
      },
      {
        "language": "FortranFixedForm",
        "path": "./snippets/fortran-fixed-form.json"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "zfls.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.path.markdownDescription%"
        },
        "zfls.incrementalSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.incrementalSync.markdownDescription%"
        },
        "zfls.signatureHelp": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.signatureHelp.markdownDescription%"
        },
        "zfls.codeActions": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.codeActions.markdownDescription%"
        },
        "zfls.hoverSignature": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.hoverSignature.markdownDescription%"
        },
        "zfls.preferImplementation": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.preferImplementation.markdownDescription%"
        },
        "zfls.lowercaseHover": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.lowercaseHover.markdownDescription%"
        },
        "zfls.lowercaseIntrinsics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.lowercaseIntrinsics.markdownDescription%"
        },
        "zfls.autocompleteNameOnly": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.autocompleteNameOnly.markdownDescription%"
        },
        "zfls.autocompleteNoSnippets": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.autocompleteNoSnippets.markdownDescription%"
        },
        "zfls.autocompleteNoAutoUse": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.autocompleteNoAutoUse.markdownDescription%"
        },
        "zfls.sortKeywords": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.sortKeywords.markdownDescription%"
        },
        "zfls.symbolSkipMembers": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.symbolSkipMembers.markdownDescription%"
        },
        "zfls.disableDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.disableDiagnostics.markdownDescription%"
        },
        "zfls.workspaceDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.workspaceDiagnostics.markdownDescription%"
        },
        "zfls.diagnosticSeverity": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "line-too-long",
              "comment-too-long",
              "statement-without-scope",
              "multiple-contains",
              "unexpected-end",
              "invalid-parent",
              "procedure-before-contains",
              "declared-twice",
              "masks-parent",
              "import-outside-interface",
              "module-not-found",
              "use-after-implicit",
              "deferred-not-implemented",
              "intent-not-in-arguments",
              "argument-not-declared",
              "not-imported",
              "object-not-found",
              "undeclared-name",
              "unused-name",
              "circular-use",
              "argument-mismatch",
              "argument-kind",
              "intent-in-assigned"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "%config.zfls.diagnosticSeverity.markdownDescription%"
        },
        "zfls.externalModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.externalModules.markdownDescription%"
        },
        "zfls.notifyInit": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.notifyInit.markdownDescription%"
        },
        "zfls.nthreads": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "scope": "resource",
          "markdownDescription": "%config.zfls.nthreads.markdownDescription%"
        },
        "zfls.maxLineLength": {
          "type": "integer",
          "default": -1,
          "scope": "resource",
          "markdownDescription": "%config.zfls.maxLineLength.markdownDescription%"
        },
        "zfls.maxCommentLineLength": {
          "type": "integer",
          "default": -1,
          "scope": "resource",
          "markdownDescription": "%config.zfls.maxCommentLineLength.markdownDescription%"
        },
        "zfls.fixedFormLineLength": {
          "type": "integer",
          "default": 72,
          "scope": "resource",
          "markdownDescription": "%config.zfls.fixedFormLineLength.markdownDescription%"
        },
        "zfls.fixedFormCommentCharacter": {
          "type": "string",
          "enum": [
            "!",
            "C",
            "c",
            "*"
          ],
          "default": "!",
          "scope": "resource",
          "markdownDescription": "%config.zfls.fixedFormCommentCharacter.markdownDescription%"
        },
        "zfls.configFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.configFile.markdownDescription%"
        },
        "zfls.sourceDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.sourceDirs.markdownDescription%"
        },
        "zfls.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.includeDirs.markdownDescription%"
        },
        "zfls.compileCommands": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.compileCommands.markdownDescription%"
        },
        "zfls.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.excludePaths.markdownDescription%"
        },
        "zfls.commentMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "%config.zfls.commentMarkers.markdownDescription%"
        },
        "zfls.includeSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.includeSuffixes.markdownDescription%"
        },
        "zfls.excludeSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.excludeSuffixes.markdownDescription%"
        },
        "zfls.ppSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.ppSuffixes.markdownDescription%"
        },
        "zfls.ppDefs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "%config.zfls.ppDefs.markdownDescription%"
        },
        "zfls.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.zfls.arguments.markdownDescription%",
          "scope": "resource"
        },
        "zfls.disableModernFortranCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.zfls.disableModernFortranCheck.markdownDescription%"
        },
        "zfls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "%config.zfls.trace.server.markdownDescription%"
        },
        "zfls.run.compiler": {
          "type": "string",
          "default": "gfortran",
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.compiler.markdownDescription%"
        },
        "zfls.run.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.run.compilerPath.markdownDescription%"
        },
        "zfls.run.buildArgs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.buildArgs.markdownDescription%"
        },
        "zfls.run.outputDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.outputDirectory.markdownDescription%"
        },
        "zfls.run.programArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.programArgs.markdownDescription%"
        },
        "zfls.run.cwd": {
          "type": "string",
          "default": "${fileDirname}",
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.cwd.markdownDescription%"
        },
        "zfls.run.debugger": {
          "type": "string",
          "enum": [
            "auto",
            "cppdbg",
            "cppvsdbg",
            "lldb",
            "gdb"
          ],
          "enumDescriptions": [
            "%config.zfls.run.debugger.enumDescriptions.0%",
            "%config.zfls.run.debugger.enumDescriptions.1%",
            "%config.zfls.run.debugger.enumDescriptions.2%",
            "%config.zfls.run.debugger.enumDescriptions.3%",
            "%config.zfls.run.debugger.enumDescriptions.4%"
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "%config.zfls.run.debugger.markdownDescription%"
        },
        "zfls.run.gdbPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.run.gdbPath.markdownDescription%"
        },
        "zfls.fpm.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.fpm.path.markdownDescription%"
        },
        "zfls.fpm.profile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.fpm.profile.markdownDescription%"
        },
        "zfls.fpm.compiler": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.fpm.compiler.markdownDescription%"
        },
        "zfls.fpm.flags": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.fpm.flags.markdownDescription%"
        },
        "zfls.fpm.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.fpm.args.markdownDescription%"
        },
        "zfls.fpm.runFile": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.fpm.runFile.markdownDescription%"
        },
        "zfls.fpm.testExplorer": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%config.zfls.fpm.testExplorer.markdownDescription%"
        },
        "zfls.formatting.formatter": {
          "type": "string",
          "enum": [
            "Disabled",
            "findent",
            "fprettify"
          ],
          "enumDescriptions": [
            "%config.zfls.formatting.formatter.enumDescriptions.0%",
            "%config.zfls.formatting.formatter.enumDescriptions.1%",
            "%config.zfls.formatting.formatter.enumDescriptions.2%"
          ],
          "default": "Disabled",
          "scope": "language-overridable",
          "markdownDescription": "%config.zfls.formatting.formatter.markdownDescription%"
        },
        "zfls.formatting.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.formatting.path.markdownDescription%"
        },
        "zfls.formatting.findentArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "language-overridable",
          "markdownDescription": "%config.zfls.formatting.findentArgs.markdownDescription%"
        },
        "zfls.formatting.fprettifyArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "language-overridable",
          "markdownDescription": "%config.zfls.formatting.fprettifyArgs.markdownDescription%"
        },
        "zfls.linter.runner": {
          "type": "string",
          "enum": [
            "extension",
            "server"
          ],
          "enumDescriptions": [
            "%config.zfls.linter.runner.enumDescriptions.0%",
            "%config.zfls.linter.runner.enumDescriptions.1%"
          ],
          "default": "extension",
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.runner.markdownDescription%"
        },
        "zfls.linter.compiler": {
          "type": "string",
          "enum": [
            "gfortran",
            "ifx",
            "ifort",
            "nagfor",
            "lfortran",
            "nvfortran",
            "flang",
            "Disabled"
          ],
          "enumDescriptions": [
            "%config.zfls.linter.compiler.enumDescriptions.0%",
            "%config.zfls.linter.compiler.enumDescriptions.1%",
            "%config.zfls.linter.compiler.enumDescriptions.2%",
            "%config.zfls.linter.compiler.enumDescriptions.3%",
            "%config.zfls.linter.compiler.enumDescriptions.4%",
            "%config.zfls.linter.compiler.enumDescriptions.5%",
            "%config.zfls.linter.compiler.enumDescriptions.6%",
            "%config.zfls.linter.compiler.enumDescriptions.7%"
          ],
          "default": "gfortran",
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.compiler.markdownDescription%"
        },
        "zfls.linter.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.linter.compilerPath.markdownDescription%"
        },
        "zfls.linter.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.extraArgs.markdownDescription%"
        },
        "zfls.linter.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.includePaths.markdownDescription%"
        },
        "zfls.linter.modOutput": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.modOutput.markdownDescription%"
        },
        "zfls.linter.lintOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.lintOnSave.markdownDescription%"
        },
        "zfls.linter.lintOnType": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.lintOnType.markdownDescription%"
        },
        "zfls.linter.lintOnTypeDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.lintOnTypeDelay.markdownDescription%"
        },
        "zfls.linter.resolveModules": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.resolveModules.markdownDescription%"
        },
        "zfls.fortitude.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.fortitude.enabled.markdownDescription%"
        },
        "zfls.fortitude.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.fortitude.path.markdownDescription%"
        },
        "zfls.fortitude.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.fortitude.args.markdownDescription%"
        },
        "zfls.fortitude.lintOnType": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.fortitude.lintOnType.markdownDescription%"
        },
        "zfls.fortitude.lintOnTypeDelay": {
          "type": "integer",
          "default": 500,
          "minimum": 50,
          "scope": "resource",
          "markdownDescription": "%config.zfls.fortitude.lintOnTypeDelay.markdownDescription%"
        },
        "zfls.codee.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.codee.enabled.markdownDescription%"
        },
        "zfls.codee.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.codee.path.markdownDescription%"
        },
        "zfls.codee.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.codee.args.markdownDescription%"
        },
        "zfls.linter.fypp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.fypp.enabled.markdownDescription%"
        },
        "zfls.linter.fypp.path": {
          "type": "string",
          "default": "fypp",
          "scope": "machine-overridable",
          "markdownDescription": "%config.zfls.linter.fypp.path.markdownDescription%"
        },
        "zfls.linter.fypp.definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.fypp.definitions.markdownDescription%"
        },
        "zfls.linter.fypp.includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.fypp.includes.markdownDescription%"
        },
        "zfls.linter.fypp.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.zfls.linter.fypp.extraArgs.markdownDescription%"
        }
      }
    },
    "commands": [
      {
        "command": "zfls.restart",
        "title": "%command.zfls.restart.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.showOutput",
        "title": "%command.zfls.showOutput.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.showCompileOrder",
        "title": "%command.zfls.showCompileOrder.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.runFile",
        "title": "%command.zfls.runFile.title%",
        "category": "%command.category%",
        "icon": "$(play)"
      },
      {
        "command": "zfls.debugFile",
        "title": "%command.zfls.debugFile.title%",
        "category": "%command.category%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "zfls.generateLaunchConfig",
        "title": "%command.zfls.generateLaunchConfig.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.fpm.run",
        "title": "%command.zfls.fpm.run.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.fpm.debug",
        "title": "%command.zfls.fpm.debug.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.linter.lint",
        "title": "%command.zfls.linter.lint.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.linter.clear",
        "title": "%command.zfls.linter.clear.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.toggleFixedFormComment",
        "title": "%command.zfls.toggleFixedFormComment.title%",
        "category": "%command.category%"
      },
      {
        "command": "zfls.fortitude.fixAll",
        "title": "%command.zfls.fortitude.fixAll.title%",
        "category": "%command.category%"
      }
    ],
    "keybindings": [
      {
        "command": "zfls.toggleFixedFormComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId == FortranFixedForm"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zfls.runFile",
          "group": "navigation@0",
          "when": "resourceLangId =~ /^Fortran(Free|Fixed)Form$/ && !isInDiffEditor && !virtualWorkspace && shellExecutionSupported"
        },
        {
          "command": "zfls.debugFile",
          "group": "navigation@1",
          "when": "resourceLangId =~ /^Fortran(Free|Fixed)Form$/ && !isInDiffEditor && !virtualWorkspace && shellExecutionSupported"
        }
      ],
      "commandPalette": [
        {
          "command": "zfls.runFile",
          "when": "editorLangId =~ /^Fortran(Free|Fixed)Form$/ && !virtualWorkspace && shellExecutionSupported"
        },
        {
          "command": "zfls.debugFile",
          "when": "editorLangId =~ /^Fortran(Free|Fixed)Form$/ && !virtualWorkspace && shellExecutionSupported"
        },
        {
          "command": "zfls.generateLaunchConfig",
          "when": "editorLangId =~ /^Fortran(Free|Fixed)Form$/ && !virtualWorkspace && shellExecutionSupported"
        },
        {
          "command": "zfls.toggleFixedFormComment",
          "when": "editorLangId == FortranFixedForm"
        },
        {
          "command": "zfls.fortitude.fixAll",
          "when": "editorLangId =~ /^Fortran(Free|Fixed)Form$/ && config.zfls.fortitude.enabled"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zfls",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "build",
              "run"
            ],
            "description": "%taskDefinition.zfls.task.description%"
          }
        }
      },
      {
        "type": "fpm",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test",
              "install",
              "clean"
            ],
            "description": "%taskDefinition.fpm.command.description%"
          },
          "target": {
            "type": "string",
            "description": "%taskDefinition.fpm.target.description%"
          },
          "example": {
            "type": "boolean",
            "description": "%taskDefinition.fpm.example.description%"
          },
          "profile": {
            "type": "string",
            "description": "%taskDefinition.fpm.profile.description%"
          },
          "compiler": {
            "type": "string",
            "description": "%taskDefinition.fpm.compiler.description%"
          },
          "flags": {
            "type": "string",
            "description": "%taskDefinition.fpm.flags.description%"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%taskDefinition.fpm.args.description%"
          },
          "programArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%taskDefinition.fpm.programArgs.description%"
          },
          "cwd": {
            "type": "string",
            "description": "%taskDefinition.fpm.cwd.description%"
          }
        }
      }
    ],
    "configurationDefaults": {
      "[FortranFixedForm]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.autoIndentOnPaste": false,
        "editor.formatOnType": true
      },
      "[FortranFreeForm]": {
        "editor.formatOnType": true
      }
    },
    "problemMatchers": [
      {
        "name": "zfls-gfortran",
        "label": "%problemMatcher.zfls-gfortran.label%",
        "owner": "fortran",
        "source": "gfortran",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.+?):(\\d+):(\\d+)(?:-\\d+)?:$",
            "file": 1,
            "line": 2,
            "column": 3
          },
          {
            "regexp": "^.*$"
          },
          {
            "regexp": "^.*$"
          },
          {
            "regexp": "^.*$"
          },
          {
            "regexp": "^(Error|Warning|Fatal Error):\\s*(.*)$",
            "severity": 1,
            "message": 2
          }
        ]
      },
      {
        "name": "zfls-intel",
        "label": "%problemMatcher.zfls-intel.label%",
        "owner": "fortran",
        "source": "ifx",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?)\\((\\d+)\\): (error|warning|remark) #(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "debuggers": [
      {
        "type": "fortran",
        "label": "%debugger.fortran.label%",
        "languages": [
          "FortranFreeForm",
          "FortranFixedForm"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.fortran.launch.program.description%"
              },
              "fpmTarget": {
                "type": "string",
                "description": "%debugger.fortran.launch.fpmTarget.description%"
              },
              "fpmTargetKind": {
                "type": "string",
                "enum": [
                  "executable",
                  "example",
                  "test"
                ],
                "default": "executable",
                "description": "%debugger.fortran.launch.fpmTargetKind.description%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "%debugger.fortran.launch.args.description%"
              },
              "cwd": {
                "type": "string",
                "description": "%debugger.fortran.launch.cwd.description%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "%debugger.fortran.launch.env.description%"
              },
              "debugger": {
                "type": "string",
                "enum": [
                  "auto",
                  "cppdbg",
                  "cppvsdbg",
                  "lldb",
                  "gdb"
                ],
                "default": "auto",
                "description": "%debugger.fortran.launch.debugger.description%"
              },
              "compiler": {
                "type": "string",
                "description": "%debugger.fortran.launch.compiler.description%"
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false,
                "description": "%debugger.fortran.launch.stopAtEntry.description%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "fortran",
            "request": "launch",
            "name": "Debug Fortran program",
            "program": "${workspaceFolder}/a.out",
            "args": [],
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.fortran.snippet.0.label%",
            "description": "%debugger.fortran.snippet.0.description%",
            "body": {
              "type": "fortran",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:a.out}\"",
              "args": []
            }
          },
          {
            "label": "%debugger.fortran.snippet.1.label%",
            "description": "%debugger.fortran.snippet.1.description%",
            "body": {
              "type": "fortran",
              "request": "launch",
              "name": "Debug ${1:target}",
              "fpmTarget": "${1:target}",
              "fpmTargetKind": "executable"
            }
          }
        ]
      }
    ],
    "walkthroughs": []
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify --sourcemap",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "package": "vsce package --no-dependencies",
    "build-test": "esbuild test/runTest.ts --bundle --outfile=out/runTest.js --platform=node --target=node20 && esbuild test/suite.ts --bundle --outfile=out/suite.js --external:vscode --format=cjs --platform=node --target=node20",
    "test": "npm run build && npm run build-test && node out/runTest.js",
    "unit": "esbuild test/unit/*.test.ts --bundle --outdir=out/unit --platform=node --target=node20 --format=cjs && node --test out/unit/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
